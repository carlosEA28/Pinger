PORT=8080
GIN_MODE=debug

# Neon/Postgres connection string used by the backend and migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB_NAME?sslmode=require&channel_binding=require

# Used as the scheduler fallback interval when there are no monitors or a database read fails.
SCHEDULER_INTERVAL_SECONDS=30

# Strict timeout for each HTTP ping request.
PING_HTTP_TIMEOUT_SECONDS=10
